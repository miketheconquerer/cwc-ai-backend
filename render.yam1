services:
  - type: web
    name: cwc-ai-backend
    runtime: python
    buildCommand: |
      apt-get update && apt-get install -y build-essential g++
      pip install --upgrade pip
      pip install wheel setuptools
      pip install --no-cache-dir -r requirements.txt
    startCommand: uvicorn server:app --host 0.0.0.0 --port 10000